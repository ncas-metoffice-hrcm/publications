@article{Thomas2012,
	Abstract = {Most climate models predict a slowing down of the Atlantic Meridional$\backslash$nOverturning Circulation during the 21st century. Using a 100 year$\backslash$nclimate change integration of a high resolution coupled climate model,$\backslash$nwe show that a 5.3 Sv reduction in the deep southward transport in$\backslash$nthe subtropical North Atlantic is balanced solely by a weakening$\backslash$nof the northward surface western boundary current, and not by an$\backslash$nincrease in the southward transport integrated across the interior$\backslash$nocean away from the western boundary. This is consistent with Sverdrup$\backslash$nbalance holding to a good approximation outside of the western boundary$\backslash$nregion on decadal time scales, and may help to spatially constrain$\backslash$npast and future change in the overturning circulation. The subtropical$\backslash$ngyre weakens by 3.4 Sv over the same period due to a weakened wind$\backslash$nstress curl. These changes combine to give a net 8.7 Sv reduction$\backslash$nin upper western boundary transport.},
	Author = {Thomas, M. D. and {De Boer}, A. M. and Stevens, D. P. and Johnson, H. L.},
	Doi = {10.1029/2012GL052702},
	File = {:Users/reinhard/Documents/articles/mendeley//Thomas et al.. 2012. Geophysical Research Letters.pdf:pdf},
	Isbn = {0094-8276},
	Issn = {00948276},
	Journal = {Geophys. Res. Lett.},
	Keywords = {Sverdrup balance,UJCC,climate change,meridional overturning circulation},
	Mendeley-Tags = {UJCC},
	Number = {July},
	Pages = {1--5},
	Title = {{Upper ocean manifestations of a reducing meridional overturning circulation}},
	Volume = {39},
	Year = {2012},
	Bdsk-Url-1 = {http://dx.doi.org/10.1029/2012GL052702}}
